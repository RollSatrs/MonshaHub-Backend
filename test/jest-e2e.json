{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src$": "<rootDir>/../src",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^shared$": "<rootDir>/../shared",
    "^shared/(.*)$": "<rootDir>/../shared/$1"
  },
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "testEnvironment": "node"
}
