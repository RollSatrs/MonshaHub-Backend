  "info": {
    "title": "MonshaHub API",
    "description": "API системы управления общественными банями",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR",
              "INVALID_CREDENTIALS",
              "EMAIL_ALREADY_EXISTS",
              "INVALID_RESET_TOKEN",
              "ROOM_NOT_AVAILABLE",
              "BOOKING_CONFLICT",
              "INSUFFICIENT_STOCK",
              "VISIT_ALREADY_COMPLETED"
            ],
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Ошибка валидации"
          },
          "details": {
            "description": "Подробности (например, список ошибок валидации)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string",
            "example": "/auth/login"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "path",
          "timestamp"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "organizationName": {
            "type": "string",
            "example": "Баня «Парная»",
            "description": "Название бани / комплекса"
          },
          "fullname": {
            "type": "string",
            "example": "Иван Иванов"
          },
          "email": {
            "type": "string",
            "example": "owner@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "organizationName",
          "fullname",
          "email",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "organizationId": {
            "type": "number",
            "example": 1
          },
          "fullname": {
            "type": "string",
            "example": "Иван Иванов"
          },
          "email": {
            "type": "string",
            "example": "owner@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "CASHIER"
            ]
          },
          "avatar": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "organizationId",
          "fullname",
          "email",
          "role",
          "avatar"
        ]
      },
      "AuthUserResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "message",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CreateCashierDto": {
        "type": "object",
        "properties": {
          "fullname": {
            "type": "string",
            "example": "Айгуль Касымова"
          },
          "email": {
            "type": "string",
            "example": "cashier@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "fullname",
          "email",
          "password"
        ]
      }
    }
  }
}
